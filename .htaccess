RewriteEngine On

ErrorDocument 404 /404.html

RewriteRule ^(Accounts|Groups|Orders)/[A-Za-z0-9-]+$ /Shop [R=302,L,NC]
RewriteRule ^History$ /MyOrders [R=302,L,NC]
RewriteRule ^(dich-vu/[A-Za-z0-9-]+|History/Cay-thue|Mini-game/[A-Za-z0-9-]+|rut-vat-pham)/?$ /Shop [R=302,L,NC]
RewriteRule ^Admin/(Category|Groups/|Group/Edit/|Accounts/|Account/Edit/|Account-Sold|Storage|Groups-cay-thue/|Mini-game|EditVQ/) /Admin/Ecommerce [R=302,L,NC]
RewriteRule ^public/admin/(Accounts|Account-Sold|Category|CategoryCayThue|EditCategoryCayThue|Groups|GroupsCayThue|EditGroup|EditGroupsCayThue|EditAccount|Mini-game|EditVongQuay|WithDraw|DonHangCayThue|DonHangBiHuy|DonHangXuLy|DonHangHoanTat|Storage)\.php$ /Admin/Ecommerce [R=302,L,NC]
RewriteRule ^public/client/(Accounts|Groups|Orders|History|CayThue|HistoryCayThue|Wheel|Withdraw)\.php$ /Shop [R=302,L,NC]
RewriteRule ^public/ctv/(ThemTaiKhoan|EditAccount|DonHangCayThue|Soid)\.php$ /Shop [R=302,L,NC]
RewriteRule ^assets/ajaxs/(Orders|CayThue|Withdraw|Quay)\.php$ - [F,L,NC]
RewriteRule ^assets/ajaxs/(admin|ctv)/(delete-account|delete-category-caythue|delete-group|delete-category)\.php$ - [F,L,NC]

RewriteRule ^Shop$ public/client/Store.php [L]
RewriteRule ^Product/([0-9]+)$ public/client/Product.php?id=$1 [L]
RewriteRule ^Cart$ public/client/Cart.php [L]
RewriteRule ^Checkout$ public/client/Checkout.php [L]
RewriteRule ^MyOrders$ public/client/MyOrders.php [L]
RewriteRule ^Affiliate$ public/client/Affiliate.php [L]
RewriteRule ^Admin/Ecommerce$ public/admin/Ecommerce.php [L]

RewriteRule ^Auth/Profile/ChangePassword public/client/Profile-ChangePassword.php [L]
RewriteRule ^Auth/Profile$ public/client/Profile.php [L]
RewriteRule ^Auth/Register$ public/client/Register.php [L]
RewriteRule ^Auth/Login$ public/client/Login.php [L]
RewriteRule ^Auth/Google$ public/client/GoogleAuth.php [L]
RewriteRule ^Auth/Google/Callback$ public/client/GoogleCallback.php [L]
RewriteRule ^Auth/Logout$ public/client/Logout.php [L]
RewriteRule ^Auth/ForgotPassword$ public/client/ForgotPassword.php [L]
RewriteRule ^Auth/ChangePassword$ public/client/ChangePassword.php [L]
RewriteRule ^Localbank$ public/client/Localbank.php [L]
RewriteRule ^History/Card$ public/client/HistoryCard.php [L]
RewriteRule ^Ket-noi-api$ public/client/Api.php [L]
RewriteRule ^Transfers$ public/client/Transfers.php [L]
RewriteRule ^Blogs$ public/client/Blogs.php [L]
RewriteRule ^Blog/([A-Za-z0-9-]+) public/client/XemBlog.php?id=$1 [L]
RewriteRule ^BuyCard$ public/client/BuyCard.php [L]
RewriteRule ^Topup$ public/client/Topup.php [L]
RewriteRule ^Bank$ public/client/Bank.php [L]
RewriteRule ^bien-dong-so-du/$ public/client/BienDongSoDu.php [L]
RewriteRule ^nap-tien-qua-ngan-hang/$ public/client/Recharge-Bank.php [L]

RewriteRule ^admin/$ public/admin/Home.php [L]
RewriteRule ^Admin/$ public/admin/Home.php [L]
RewriteRule ^Admin$ public/admin/Home.php [L]
RewriteRule ^Admin/Home$ public/admin/Home.php [L]
RewriteRule ^Admin/Users$ public/admin/Users.php [L]
RewriteRule ^Admin/User/Edit/([A-Za-z0-9-]+) public/admin/EditUser.php?id=$1 [L]
RewriteRule ^Admin/Setting$ public/admin/Setting.php [L]
RewriteRule ^Admin/Cards$ public/admin/Cards.php [L]
RewriteRule ^Admin/Bank$ public/admin/Bank.php [L]